        "@tanstack/react-start": "^1.168.14",
        "@tanstack/react-table": "^8.21.3",
        "axios": "^1.12.2",
        "date-fns": "^4.1.0",
        "echarts": "^6.0.0",
        "echarts-for-react": "^3.0.2",
        "echarts-gl": "^2.0.9",
        "lightweight-charts": "^5.2.0",
        "lodash-es": "^4.17.21",
        "react": "^19.1.1",
        "react-dom": "^19.1.1",
        "react-grid-layout": "^1.5.2",
